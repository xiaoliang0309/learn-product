<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overseas.learning.dao.MerchantMapper">

    <!-- 通用结果映射：把数据库字段映射到实体属性 -->
    <resultMap id="BaseResult" type="Merchant">
        <id column="id" property="id"/>
        <result column="full_name" property="fullName"/>
        <result column="short_name" property="shortName"/>
        <result column="biz_type" property="bizType"/>
        <result column="currency" property="currency"/>
        <result column="country" property="country"/>
        <result column="state" property="state"/>
        <result column="city" property="city"/>
        <result column="address" property="address"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 插入（自增 ID 回填） -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO merchant (full_name, short_name, biz_type, currency, country, state, city, address, email, phone, status)
        VALUES (#{fullName}, #{shortName}, #{bizType}, #{currency}, #{country}, #{state}, #{city}, #{address}, #{email}, #{phone}, 1)
    </insert>

    <!-- 按 ID 查询 -->
    <select id="selectById" resultMap="BaseResult">
        SELECT * FROM merchant WHERE id = #{id}
    </select>

    <!-- 条件查询（动态 SQL） -->
    <select id="selectList" resultMap="BaseResult">
        SELECT * FROM merchant
        <where>
            <if test="fullName != null and fullName != ''">
                AND full_name LIKE CONCAT('%', #{fullName}, '%')
            </if>
            <if test="bizType != null">
                AND biz_type = #{bizType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- 统计总数 -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM merchant
        <where>
            <if test="fullName != null and fullName != ''">
                AND full_name LIKE CONCAT('%', #{fullName}, '%')
            </if>
            <if test="bizType != null">
                AND biz_type = #{bizType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 更新 -->
    <update id="update">
        UPDATE merchant
        SET full_name = #{fullName},
            short_name = #{shortName},
            biz_type = #{bizType},
            country = #{country},
            state = #{state},
            city = #{city},
            address = #{address},
            email = #{email},
            phone = #{phone},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM merchant WHERE id = #{id}
    </delete>

    <!-- 按邮箱查询 -->
    <select id="selectByEmail" resultMap="BaseResult">
        SELECT * FROM merchant WHERE email = #{email} LIMIT 1
    </select>

</mapper>